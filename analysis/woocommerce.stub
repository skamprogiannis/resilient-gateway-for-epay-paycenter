<?php
/**
 * WC_Data forwards metadata values to WC_Meta_Data without a string-only check.
 * The upstream string|array annotation excludes persisted numeric installments.
 */
abstract class WC_Data {
	/**
	 * @param string $key Meta key.
	 * @param mixed $value Value serialized by the WooCommerce data store.
	 * @param int $meta_id Meta ID.
	 * @return void
	 */
	public function update_meta_data( $key, $value, $meta_id = 0 ) {}
}
