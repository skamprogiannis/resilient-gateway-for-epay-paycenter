<?xml version="1.0"?>
<ruleset name="Resilient Gateway for ePay Paycenter">
	<description>WordPress coding standards for the distributable plugin.</description>

	<file>resilient-gateway-for-epay-paycenter.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>templates</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<arg name="basepath" value="." />
	<arg name="colors" />
	<arg value="ps" />

	<rule ref="WordPress" />
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce" />
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="resilient-gateway-for-epay-paycenter" />
			</property>
		</properties>
	</rule>
</ruleset>
