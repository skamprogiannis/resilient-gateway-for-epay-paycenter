{
  "name": "resilient-gateway-for-epay-paycenter",
  "version": "2.1.0",
  "private": true,
  "description": "Development checks for the browser assets shipped with the WooCommerce gateway.",
  "scripts": {
    "check:js": "tsc --project jsconfig.json",
    "test": "npm run check:js",
    "test:integration": "bash scripts/run-playwright.sh test --project=chromium-desktop",
    "test:matrix": "bash scripts/run-playwright.sh test --grep @matrix"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "@playwright/test": "1.61.1"
  }
}
